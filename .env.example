# Environment Configuration
# Copy this to .env and fill in your values

# AI Model API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
KIMI_API_KEY=your_kimi_api_key_here
QWEN_API_KEY=your_qwen_api_key_here

# Target Application
BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://api.example.com

# Healing Configuration
HEALING_ENABLED=true
HEALING_CONFIDENCE_THRESHOLD=0.7
MAX_HEALING_ATTEMPTS=3
HEALING_TIMEOUT_MS=10000
KNOWLEDGE_BASE_PATH=./reports/healing-logs/knowledge-base.json

# Test Configuration
RETRY_COUNT=2
DEFAULT_TIMEOUT=30000
SLOW_MO=0
HEADLESS=false
PARALLEL_WORKERS=4

# Reporting
ALLURE_RESULTS_PATH=./reports/allure-results
HTML_REPORT_PATH=./reports/html-report
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=false

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./reports/healing-logs/app.log

# Docker
DOCKER_REGISTRY=autoheal-qa
DOCKER_TAG=latest
